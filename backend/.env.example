# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (M0 free tier) - TRD Section 4 / 11
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pawprint

# JWT - TRD Section 9 (Session/token security)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Google Sign-In server-side verification - TRD TR-003b
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# CORS - TRD TR-016 (comma-separated, no wildcards in production)
WEB_ORIGIN=http://localhost:5173

# Public URL of the web app — used for links inside emails (password reset, dashboard).
# Defaults to the first WEB_ORIGIN.
# APP_URL=http://localhost:5173

# Email (Nodemailer) — reminder digests, appointment confirmations, password resets.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16-character code as EMAIL_PASS
# (NOT your normal Gmail password).
# Leave these as-is in development and every email gets a browser preview link
# (printed in the backend console) instead of being delivered.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=PawPrint <your_gmail@gmail.com>

# Set to false to turn off the daily 8:00 AM reminder email job
EMAIL_REMINDERS_ENABLED=true

# Behind a hosting proxy/load balancer (Render, Railway, Heroku) set this to 1 so
# rate limits see the real visitor IP
# TRUST_PROXY=1
