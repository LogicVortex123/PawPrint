# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (M0 free tier) - TRD Section 4 / 11
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pawprint

# JWT - TRD Section 9 (Session/token security)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Google Sign-In server-side verification - TRD TR-003b
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# CORS - TRD TR-016 (comma-separated, no wildcards in production)
WEB_ORIGIN=http://localhost:5173
